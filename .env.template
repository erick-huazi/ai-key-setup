# AI CLI API Keys 配置模板
# 复制此文件为 .env 并填入你的真实 API Key
# 警告: 请勿将 .env 提交到 Git 仓库！

# OpenAI (Codex CLI)
# 获取: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Anthropic (Claude Code)
# 获取: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini
# 获取: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="..."

# DeepSeek
# 获取: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="sk-..."

# Z.AI (智谱 GLM)
# 获取: https://open.bigmodel.cn/
ZAI_API_KEY="..."

# GitHub Personal Access Token
# 获取: https://github.com/settings/tokens
GITHUB_TOKEN="ghp_..."

# ============================================
# 自定义变量（按需添加）
# ============================================
# MY_CUSTOM_VAR="value"
